<?xml version="1.0"?>
<ruleset name="Portal Users">
    <description>Standardy kodu dla wtyczki Portal Users.</description>

    <file>src</file>
    <file>portal-users.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="ps"/>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    </rule>
    <rule ref="WordPress-Core">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    </rule>
    <rule ref="WordPress-Docs">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="portal-users"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="pusers"/>
                <element value="PortalUsers"/>
            </property>
        </properties>
    </rule>

    <!-- CsvDocument sklada dokument w buforze php://temp i nie dotyka systemu plików, a warstwa domeny nie może sięgać
         do abstrakcji platformy. Nazwy reguły nie da się wpisać w komentarzu w src/Domain/**, bo strażnik czystości
         domeny wyłapuje w niej obce słowo, więc wyjątek siedzi tutaj. Zawężenie do src/Domain/Export/* jest celowe:
         pierwsze prawdziwe fopen() gdziekolwiek indziej ma dalej zapalać ostrzeżenie. -->
    <rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fopen">
        <exclude-pattern>src/Domain/Export/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fclose">
        <exclude-pattern>src/Domain/Export/*</exclude-pattern>
    </rule>

    <!-- Odcisk mapowania importu wymaga kanonicznego kodowania, a warstwa domeny nie może sięgać po opakowanie
         platformy. Nazwy reguły nie da się wpisać w komentarzu w src/Domain/**, bo strażnik czystości domeny
         wyłapuje w niej obce słowo, więc wyjątek siedzi tutaj. Zawężenie do src/Domain/Import/* jest celowe. -->
    <rule ref="WordPress.WP.AlternativeFunctions.json_encode_json_encode">
        <exclude-pattern>src/Domain/Import/*</exclude-pattern>
    </rule>

    <config name="minimum_wp_version" value="6.5"/>

    <!-- Wpis „testVersion" stał tu i nie strzegł niczego: ma znaczenie wyłącznie przy zainstalowanym
         standardzie PHPCompatibility, którego nie ma w vendor/ ani w require-dev. Usunięta w Planie 9,
         bo czytała się jak straż wersji minimalnej PHP. PHPCompatibility nie wraca: jego najnowsze stabilne
         wydanie (php-compatibility 9.3.5) jest z grudnia 2019, żaden z jego 117 sniffów nie zna PHP 8.1
         ani 8.2, a na metodzie enuma używającej $this daje fałszywe trafienie.

         Podłogi PHP pilnują dziś dwie rzeczy, obie poza tym plikiem:
         - PHPStan analizuje kod jako PHP 8.1, bo bierze wersję z config.platform.php w composer.json
           (zgodność trzech miejsc trzyma tests/Unit/PhpFloorTest.php) — łapie gramatykę ponad podłogą;
         - `composer lint:syntax` uruchamia php -l w kontenerze 8.1 — łapie też błędy kompilacji,
           których PHPStan nie widzi (wyrażenie stałe czytające enum przechodzi u niego zielono).
         Nie łapie ich nic: wywołanie funkcji istniejącej w PHP, ale nie na podłodze (mb_scrub() na 8.1)
         przechodzi obie bramki — zob. Plan 9, rozstrzygnięcie P3a. -->
</ruleset>
